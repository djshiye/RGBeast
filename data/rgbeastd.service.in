[Unit]
Description=RGBeast RGB lighting daemon
Documentation=man:rgbeastd(8)
After=systemd-modules-load.service

[Service]
Type=dbus
BusName=io.github.djshiye.RGBeast1
ExecStart=@libexecdir@/rgbeastd
User=@rgbeast_user@
Group=@rgbeast_user@
StateDirectory=rgbeast
Restart=on-failure
RestartSec=2

# Sandbox: the daemon needs its state directory, D-Bus, hidraw and i2c-dev. Nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
DevicePolicy=closed
DeviceAllow=char-hidraw rw
DeviceAllow=char-i2c rw
DeviceAllow=/dev/i2c-0 rw
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=/dev/i2c-2 rw
DeviceAllow=/dev/i2c-3 rw
DeviceAllow=/dev/i2c-4 rw
DeviceAllow=/dev/i2c-5 rw
DeviceAllow=/dev/i2c-6 rw
DeviceAllow=/dev/i2c-7 rw
DeviceAllow=/dev/i2c-8 rw
DeviceAllow=/dev/i2c-9 rw
DeviceAllow=/dev/i2c-10 rw
DeviceAllow=/dev/i2c-11 rw
DeviceAllow=/dev/i2c-12 rw
DeviceAllow=/dev/i2c-13 rw
DeviceAllow=/dev/i2c-14 rw
DeviceAllow=/dev/i2c-15 rw
DeviceAllow=/dev/i2c-16 rw
DeviceAllow=/dev/i2c-17 rw
DeviceAllow=/dev/i2c-18 rw
DeviceAllow=/dev/i2c-19 rw
DeviceAllow=/dev/i2c-20 rw

[Install]
WantedBy=multi-user.target
