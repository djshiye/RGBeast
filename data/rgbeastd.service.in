[Unit]
Description=RGBeast RGB lighting daemon
Documentation=man:rgbeastd(8)
After=systemd-modules-load.service systemd-udev-trigger.service

[Service]
Type=dbus
BusName=io.github.djshiye.RGBeast1
ExecStart=@libexecdir@/rgbeastd
User=@rgbeast_user@
Group=@rgbeast_user@
StateDirectory=rgbeast
Restart=on-failure
RestartSec=2

# Sandbox: the daemon needs its state directory, D-Bus, hidraw and i2c-dev. Nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
DevicePolicy=closed
DeviceAllow=char-hidraw rw
DeviceAllow=char-i2c rw

[Install]
WantedBy=multi-user.target
