<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RGBeast</vendor>
  <vendor_url>https://github.com/djshiye/RGBeast</vendor_url>
  <icon_name>io.github.djshiye.RGBeast</icon_name>

  <action id="io.github.djshiye.rgbeast.control">
    <description>Control RGB lighting</description>
    <message>Authentication is required to change the lighting of this computer</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <!-- The daemon runs as an unprivileged user. Since polkit 124 only root or
         the action's owner may check authorisation for other identities. -->
    <annotate key="org.freedesktop.policykit.owner">unix-user:@rgbeast_user@</annotate>
  </action>
</policyconfig>
